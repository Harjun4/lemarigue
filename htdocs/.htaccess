# Apache Configuration for InfinityFree / Shared Hosting
# Rewrite Engine & Clean URLs

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Block access to hidden files and sensitive directories
    RewriteRule ^\.git - [F,L]
    RewriteRule ^config/.*$ - [F,L]
    RewriteRule ^models/.*$ - [F,L]
    RewriteRule ^controllers/.*$ - [F,L]
    RewriteRule ^views/.*$ - [F,L]
    RewriteRule \.(sql|md|json|lock)$ - [F,L]

    # Allow direct access to real files and directories (assets, uploads)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Route everything else to index.php
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Set UTF-8 encoding
AddDefaultCharset UTF-8
